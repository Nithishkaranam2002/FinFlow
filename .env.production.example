# FinFlow production environment — copy to .env and fill secrets before deploy.
# On a server: cp .env.production.example .env && nano .env

APP_NAME=FinFlow
APP_ENV=production
APP_PORT=8000
SECRET_KEY=CHANGE_ME_openssl_rand_hex_32
DEBUG=false
CORS_ORIGINS=http://YOUR_SERVER_IP:8088,http://YOUR_SERVER_IP
APP_BASE_URL=http://YOUR_SERVER_IP:8088
USE_POSTGRES_CHECKPOINTER=true
ALLOW_REGISTRATION=false
RATE_LIMIT_ENABLED=true
LOG_LEVEL=info
METRICS_ENABLED=true

S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=finflow
S3_SECRET_KEY=CHANGE_ME_strong_minio_secret
S3_BUCKET=finflow-documents
S3_REGION=us-east-1
S3_USE_SSL=false

DATABASE_URL=postgresql+asyncpg://finflow:CHANGE_ME_db_password@postgres:5432/finflow_db
DATABASE_SYNC_URL=postgresql://finflow:CHANGE_ME_db_password@postgres:5432/finflow_db
REDIS_URL=redis://redis:6379/0
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
TEMPORAL_ADDRESS=temporal:7233
TEMPORAL_ENABLED=true
QDRANT_URL=http://qdrant:6333

LANGFUSE_PUBLIC_KEY=your-key
LANGFUSE_SECRET_KEY=your-key
LANGFUSE_HOST=https://us.cloud.langfuse.com

ANTHROPIC_API_KEY=
LITELLM_MASTER_KEY=CHANGE_ME_litellm_master
PRIMARY_MODEL=gpt-4o-mini
STANDARD_MODEL=gpt-4o-mini
PREMIUM_MODEL=gpt-4o
FALLBACK_MODEL=gpt-4o-mini

JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
SECRETS_BACKEND=env

RESEND_API_KEY=
EMAIL_FROM=noreply@yourdomain.com
SENTRY_DSN=
