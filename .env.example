# Application
# Display name used in logs, emails, and API metadata
APP_NAME=FinFlow
# Runtime environment: development, staging, or production
APP_ENV=development
# Port the FastAPI server binds to
APP_PORT=8000
# Secret key for signing sessions and internal tokens (change in production)
SECRET_KEY=your-secret-key-here
# Enable verbose logging and auto-reload during local development
DEBUG=true
# Comma-separated allowed browser origins for CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Persist LangGraph approval checkpoints in PostgreSQL (auto-enabled when APP_ENV=production)
USE_POSTGRES_CHECKPOINTER=false
# Allow public /register endpoint (disabled automatically in production)
ALLOW_REGISTRATION=true
# Redis-backed API and login rate limits
RATE_LIMIT_ENABLED=true
API_RATE_LIMIT_PER_MINUTE=120
LOGIN_RATE_LIMIT_PER_MINUTE=10
# Maximum upload size for invoices and bank statements (bytes)
MAX_UPLOAD_SIZE_BYTES=10485760
# Re-queue invoices stuck in received/extracting longer than this (minutes)
STALE_INVOICE_MINUTES=30
# Application log level: debug, info, warning, error
LOG_LEVEL=info
# Sentry error tracking (optional)
SENTRY_DSN=
# Prometheus /metrics endpoint
METRICS_ENABLED=true

# Object storage (MinIO locally, S3 in production)
S3_ENDPOINT_URL=http://localhost:9002
S3_ACCESS_KEY=finflow
S3_SECRET_KEY=finflow123
S3_BUCKET=finflow-documents
S3_REGION=us-east-1
S3_USE_SSL=false

# Secrets backend: env | aws
SECRETS_BACKEND=env
AWS_SECRETS_ARN=

# Database
# Async SQLAlchemy connection string (used by FastAPI and async workers)
DATABASE_URL=postgresql+asyncpg://finflow:finflow123@localhost:5432/finflow_db
# Sync SQLAlchemy connection string (used by Alembic migrations and Celery)
DATABASE_SYNC_URL=postgresql://finflow:finflow123@localhost:5432/finflow_db

# Redis
# Redis connection URL for caching, rate limiting, and Celery broker/backend
REDIS_URL=redis://localhost:6379

# Kafka
# Comma-separated Kafka broker addresses (reconciliation events)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Temporal workflow engine (replaces Celery)
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_ENABLED=true

# AI Providers
# OpenAI API key for GPT models and embeddings
OPENAI_API_KEY=sk-your-key-here
# Anthropic API key for Claude models
ANTHROPIC_API_KEY=sk-ant-your-key-here

# LiteLLM
# Master key for LiteLLM proxy authentication
LITELLM_MASTER_KEY=sk-finflow-master
# Default model for routine agent tasks (cost-efficient)
PRIMARY_MODEL=gpt-4o-mini
# Standard tier for text extraction and reconciliation matching
STANDARD_MODEL=gpt-4o-mini
# High-capability model for complex reasoning, approvals, and vision extraction
PREMIUM_MODEL=gpt-4o
# Fallback model when primary providers are unavailable
FALLBACK_MODEL=gpt-4o-mini

# Langfuse observability
# Public key for Langfuse tracing dashboard
LANGFUSE_PUBLIC_KEY=your-key
# Secret key for Langfuse API authentication
LANGFUSE_SECRET_KEY=your-key
# Langfuse instance URL (cloud or self-hosted). LANGFUSE_BASE_URL is accepted as an alias.
LANGFUSE_HOST=https://us.cloud.langfuse.com
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com

# Mem0
# API key for Mem0 long-term agent memory
MEM0_API_KEY=your-key-here

# QuickBooks sandbox
# OAuth client ID for QuickBooks Online integration
QUICKBOOKS_CLIENT_ID=your-id
# OAuth client secret for QuickBooks Online integration
QUICKBOOKS_CLIENT_SECRET=your-secret
# Use QuickBooks sandbox environment when true
QUICKBOOKS_SANDBOX=true

# Resend email
# Resend API key for transactional email delivery
RESEND_API_KEY=your-key
# Sender address for outbound notifications
EMAIL_FROM=noreply@finflow.dev
# Public base URL for approval links in email and Slack
APP_BASE_URL=http://localhost:8000
# Optional Slack incoming webhook for approval Block Kit cards
SLACK_WEBHOOK_URL=

# Qdrant vector database
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

# JWT Auth
# Algorithm used to sign JWT access tokens
JWT_ALGORITHM=HS256
# Access token lifetime in minutes (1440 = 24 hours)
JWT_EXPIRE_MINUTES=1440
